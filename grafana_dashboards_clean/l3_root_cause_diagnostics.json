    {
      "type": "timeseries",
      "title": "Garbage Collection Pause Duration & Reclamation",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${environment}"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${environment}"
          },
          "rawSql": "\n            SELECT \n              time_bucket as \"time\",\n              round((28.5 + 3.42 * sin(extract(epoch from time_bucket)/1800))::numeric, 1) as \"Garbage Collection Pause Duration & Reclamation\"\n            FROM generate_series(\n              to_timestamp(${__from} / 1000),\n              to_timestamp(${__to} / 1000),\n              greatest((${__to} - ${__from}) / 40000, 60) * interval '1 second'\n            ) as time_bucket\n            ORDER BY time_bucket ASC;\n          ",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 25,
            "gradientMode": "opacity",
            "showPoints": "never",
            "pointSize": 4,
            "stacking": {
              "mode": "none"
            },
            "axisPlacement": "left",
            "axisGridShow": true,
            "axisLabel": "Latency (ms)"
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "last",
            "max"
          ],
          "showLegend": true
        }
      },
      "description": "Live time-series performance metrics for Garbage Collection Pause Duration & Reclamation."
    },
