# Serve using Nginx with clean web root and SSL support
FROM nginx:1.25-alpine

RUN apk add --no-cache openssl && \
    mkdir -p /etc/ssl/private /etc/ssl/certs && \
    openssl req -x509 -nodes -days 3650 -newkey rsa:2048 \
    -keyout /etc/ssl/private/nginx-selfsigned.key \
    -out /etc/ssl/certs/nginx-selfsigned.crt \
    -subj "/C=IN/ST=Maharashtra/L=Pune/O=Futane Agro/OU=ERP/CN=80-225-192-171.sslip.io"

# Clean default Nginx static files completely
RUN rm -rf /usr/share/nginx/html/*

# Copy built Angular 17 output directly into /usr/share/nginx/html/
COPY dist-prod/frontend/browser/ /usr/share/nginx/html/


COPY nginx-prod.conf /etc/nginx/conf.d/default.conf

EXPOSE 80 443
CMD ["nginx", "-g", "daemon off;"]
