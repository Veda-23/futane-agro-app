# Stage 1: Serve using Nginx (Pre-built locally to save VM memory)
FROM nginx:1.25-alpine
ARG BUILD_TIME=1
RUN echo "Force fresh build: $BUILD_TIME"
COPY dist-uat/frontend/browser/browser /usr/share/nginx/html
COPY nginx-uat.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]

